<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="ir.ui.view" id="view_res_company_jurisdiction_padron_list">
        <field name="name">res.company.jurisdiction.padron.list</field>
        <field name="model">res.company.jurisdiction.padron</field>
        <field name="arch" type="xml">
            <list string="Padrón de Alícuotas">
                <field name="state_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="l10n_ar_padron_from_date"/>
                <field name="l10n_ar_padron_to_date"/>
            </list>
        </field>
    </record>

    <record model="ir.ui.view" id="view_res_company_jurisdiction_padron_form">
        <field name="name">res.company.jurisdiction.padron.form</field>
        <field name="model">res.company.jurisdiction.padron</field>
        <field name="arch" type="xml">
            <form string="Padrón de Alícuotas">
                <sheet>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="state_id"/>
                            <field name="file_padron" filename="filename"/>
                            <field name="filename" invisible="1"/>
                        </group>
                        <group>
                            <field name="l10n_ar_padron_from_date"/>
                            <field name="l10n_ar_padron_to_date"/>
                        </group>
                    </group>
                    <p class="alert alert-info" role="alert" style="margin-bottom:0px;">
                        Padrones implementados:
                        <ul>
                            <li>
                                <b>ARBA (Buenos Aires):</b> se sube el archivo zip que publica ARBA,
                                con nombre de forma "PadronRGSMMAAAA.zip". Ese zip contiene
                                <b>dos archivos separados</b> ("...Per..." y "...Ret..."), uno con
                                las alícuotas de percepción y otro con las de retención.
                            </li>
                            <li>
                                <b>AGIP (CABA):</b> formato <b>sin confirmar todavía</b> contra un
                                archivo real de AGIP (se asume, sin validar, un único archivo con
                                nombre de forma "ARDJUMMAAAA.rar/.TXT" con percepción y retención
                                en la misma línea). No cargar un padrón real de CABA a producción
                                sin confirmar antes este formato contra un archivo bajado del
                                portal de AGIP.
                            </li>
                        </ul>
                        No confundir el formato de ambas jurisdicciones: no son intercambiables.
                    </p>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="act_company_jurisdiction_padron">
        <field name="name">Padrón de Alícuotas IIBB</field>
        <field name="res_model">res.company.jurisdiction.padron</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        name="Padrón de Alícuotas IIBB"
        action="act_company_jurisdiction_padron"
        id="menu_action_company_jurisdiction_padron"
        sequence="100"
        parent="account.menu_finance_configuration"
    />

</odoo>
